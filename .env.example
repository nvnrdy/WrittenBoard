# Firebase Web app config (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional App Check (reCAPTCHA v3 site key). Without it, initAppCheck is a no-op.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Optional comma-separated extra browser origins for cookie auth CSRF checks
# (defaults already include writtenboard.com and the App Hosting URL).
ALLOWED_ORIGINS=

# Server-side Firebase Admin credentials. Prefer Application Default Credentials
# on Google Cloud; for local development use a service account key kept OUTSIDE git.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Must match the SDK storageBucket (prefer *.firebasestorage.app).
FIREBASE_STORAGE_BUCKET=

# Optional moderation. Default is fail-closed manual review for media.
MODERATION_PROVIDER=manual
OPENAI_API_KEY=

# Optional YouTube player ID only; this does NOT start a livestream.
NEXT_PUBLIC_YOUTUBE_LIVE_ID=
# Optional channel URL for "Watch WrittenBoard on YouTube" (https://www.youtube.com/@YourHandle)
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=

# One-time admin bootstrap; set only for the command invocation, not deployment.
FIREBASE_BOOTSTRAP_ADMIN_UID=

# Media cleanup job secret for Cloud Scheduler / cron hitting POST /api/cleanup/media
CLEANUP_JOB_SECRET=

# Broadcast worker
BROADCAST_MODE=dry-run
BROADCAST_HOLD_MS=8000
BROADCAST_POLL_MS=3000
FFMPEG_PATH=
YOUTUBE_STREAM_KEY=

